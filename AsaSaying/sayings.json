[
  {
    "id": 1,
    "text": "人与人之间，大概只有刚认识的时候最好，虚伪又热情，新鲜又浪漫。",
    "category": "人间清醒",
    "tags": ["人际关系", "扎心"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 2,
    "text": "这世上，除了自己，都是别人。",
    "category": "人间清醒",
    "tags": ["自我", "独立"],
    "vibe": "清醒独立",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 3,
    "text": "你没有那么多观众，不妨大胆一点生活。",
    "category": "人间清醒",
    "tags": ["自我", "自由"],
    "vibe": "豁达解压",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 4,
    "text": "旧账重提，是因为它从未被妥善解决。",
    "category": "人间清醒",
    "tags": ["感情", "人性"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 5,
    "text": "把期望降低，所有的遇见都是礼物。",
    "category": "人间清醒",
    "tags": ["心态", "成长"],
    "vibe": "治愈清醒",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 6,
    "text": "人可以说谎，但细节不会，爱是积累，不爱也是。",
    "category": "人间清醒",
    "tags": ["感情", "细节"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 7,
    "text": "看透后，一半是理解一半是算了。",
    "category": "人间清醒",
    "tags": ["成长", "豁达"],
    "vibe": "人间真实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 8,
    "text": "后来我知道了，很多事情上都可以努力，但人与人之间不行。能走到最后的，其实一开始就是同路人。",
    "category": "人间清醒",
    "tags": ["人际关系", "释怀"],
    "vibe": "清醒独立",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 9,
    "text": "永远不要对任何一件事后悔，因为那曾经是你一度最想要的。",
    "category": "人间清醒",
    "tags": ["选择", "后悔"],
    "vibe": "清醒独立",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 10,
    "text": "你不热情，就不会觉得别人冷淡。",
    "category": "人间清醒",
    "tags": ["心态", "人际"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 11,
    "text": "连天气都是阴晴不定，谁又能保证身边的一切不会变。",
    "category": "人间清醒",
    "tags": ["变化", "释怀"],
    "vibe": "人间真实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 12,
    "text": "散伙是人间常态，谁都不是例外。",
    "category": "人间清醒",
    "tags": ["离别", "感情"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 13,
    "text": "成年人最大的自律，就是克制自己去纠正别人的欲望。",
    "category": "人间清醒",
    "tags": ["自律", "人际"],
    "vibe": "清醒独立",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 14,
    "text": "万丈深渊终有底，唯有人心不可测。",
    "category": "人间清醒",
    "tags": ["人性", "现实"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 15,
    "text": "生活可以是甜的，也可以是苦的，但不能是没味儿的。",
    "category": "人间清醒",
    "tags": ["生活", "态度"],
    "vibe": "治愈清醒",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 16,
    "text": "我最大的能耐，就是躺着不动。",
    "category": "摆烂哲学",
    "tags": ["卡夫卡", "摆烂"],
    "vibe": "三观不正但爽",
    "author": "弗兰兹·卡夫卡",
    "source": "《卡夫卡日记》",
    "attribution_status": "confirmed"
  },
  {
    "id": 17,
    "text": "我从没喜欢过工作，我的目标永远是得过且过。",
    "category": "摆烂哲学",
    "tags": ["雷蒙德·卡佛", "工作"],
    "vibe": "三观不正但爽",
    "author": "雷蒙德·卡佛",
    "source": "《雷蒙德·卡佛访谈录》",
    "attribution_status": "confirmed"
  },
  {
    "id": 18,
    "text": "天气好极了。钱几乎没有。",
    "category": "摆烂哲学",
    "tags": ["契诃夫", "贫穷"],
    "vibe": "黑色幽默",
    "author": "安东·契诃夫",
    "source": "《契诃夫书信集》",
    "attribution_status": "confirmed"
  },
  {
    "id": 19,
    "text": "你想干什么？我想游手好闲。",
    "category": "摆烂哲学",
    "tags": ["毛姆", "理想"],
    "vibe": "三观不正但爽",
    "author": "威廉·萨默塞特·毛姆",
    "source": "《作家笔记》",
    "attribution_status": "confirmed"
  },
  {
    "id": 20,
    "text": "很累。不想爱了，也不想劳动了。",
    "category": "摆烂哲学",
    "tags": ["托尔斯泰", "摆烂"],
    "vibe": "人间真实",
    "author": "列夫·托尔斯泰",
    "source": "《托尔斯泰日记》",
    "attribution_status": "confirmed"
  },
  {
    "id": 21,
    "text": "我第一天来文化馆上班时故意迟到了两小时，结果我发现自己是第一个来的。我心想，这地方来对了。",
    "category": "摆烂哲学",
    "tags": ["余华", "工作"],
    "vibe": "黑色幽默",
    "author": "余华",
    "source": "《我在文化馆的日子》访谈",
    "attribution_status": "confirmed"
  },
  {
    "id": 22,
    "text": "努力不一定成功，但不努力一定很舒服。",
    "category": "摆烂哲学",
    "tags": ["努力", "摆烂"],
    "vibe": "三观不正但爽",
    "author": "佚名",
    "source": "网络流行语",
    "attribution_status": "anonymous"
  },
  {
    "id": 23,
    "text": "世上无难事，只要肯放弃。",
    "category": "摆烂哲学",
    "tags": ["困难", "放弃"],
    "vibe": "三观不正但爽",
    "author": "佚名",
    "source": "网络流行语",
    "attribution_status": "anonymous"
  },
  {
    "id": 24,
    "text": "做事一定要三思而后行：能不能不做，能不能明天做，能不能交给别人做。",
    "category": "摆烂哲学",
    "tags": ["拖延", "职场"],
    "vibe": "黑色幽默",
    "author": "佚名",
    "source": "网络段子",
    "attribution_status": "anonymous"
  },
  {
    "id": 25,
    "text": "既然总有人会被淘汰，那为什么不能是我呢？",
    "category": "摆烂哲学",
    "tags": ["竞争", "摆烂"],
    "vibe": "三观不正但爽",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 26,
    "text": "人生不摆烂，快乐少一半。",
    "category": "摆烂哲学",
    "tags": ["快乐", "态度"],
    "vibe": "三观不正但爽",
    "author": "佚名",
    "source": "网络流行语",
    "attribution_status": "anonymous"
  },
  {
    "id": 27,
    "text": "间接性摆烂，经常性快乐。",
    "category": "摆烂哲学",
    "tags": ["快乐", "心态"],
    "vibe": "三观不正但爽",
    "author": "佚名",
    "source": "网络流行语",
    "attribution_status": "anonymous"
  },
  {
    "id": 28,
    "text": "一旦学会摆烂，你会发现世界豁然开朗。",
    "category": "摆烂哲学",
    "tags": ["心态", "解压"],
    "vibe": "三观不正但爽",
    "author": "佚名",
    "source": "网络流行语",
    "attribution_status": "anonymous"
  },
  {
    "id": 29,
    "text": "我过着一种不正确的生活。我什么也不做，并且睡得很晚。",
    "category": "摆烂哲学",
    "tags": ["哈尔姆斯", "生活"],
    "vibe": "人间真实",
    "author": "丹尼尔·哈尔姆斯",
    "source": "《哈尔姆斯日记》",
    "attribution_status": "confirmed"
  },
  {
    "id": 30,
    "text": "我没有钱用，但又懒得去挣钱。",
    "category": "摆烂哲学",
    "tags": ["契诃夫", "贫穷"],
    "vibe": "人间真实",
    "author": "安东·契诃夫",
    "source": "《契诃夫书信集》",
    "attribution_status": "confirmed"
  },
  {
    "id": 31,
    "text": "心软的人永远被践踏，心狠的人永远最潇洒。",
    "category": "扎心现实",
    "tags": ["人性", "现实"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 32,
    "text": "没有收拾残局的能力，就别放纵你那无用的情绪。",
    "category": "扎心现实",
    "tags": ["情绪", "能力"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 33,
    "text": "吃土的时候没有人问你苦不苦，吃肉的时候总有人问你香不香。",
    "category": "扎心现实",
    "tags": ["人性", "人际"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 34,
    "text": "人教人教不会，事教人一次就会。",
    "category": "扎心现实",
    "tags": ["成长", "教训"],
    "vibe": "人间真实",
    "author": "佚名",
    "source": "民间谚语",
    "attribution_status": "anonymous"
  },
  {
    "id": 35,
    "text": "你赚不到认知以外的钱。",
    "category": "扎心现实",
    "tags": ["认知", "财富"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 36,
    "text": "比世人的目光还要可怕的，实际上是你自己那颗在意世人目光的心。",
    "category": "扎心现实",
    "tags": ["自我", "焦虑"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 37,
    "text": "就怕你一生碌碌无为，还安慰自己平凡可贵。",
    "category": "扎心现实",
    "tags": ["平庸", "自我安慰"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 38,
    "text": "没人会突然不爱你，只是你突然知道而已。",
    "category": "扎心现实",
    "tags": ["感情", "人性"],
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 39,
    "text": "不要看破红尘，因为红尘本来就是破的。",
    "category": "扎心现实",
    "tags": ["人生", "通透"],
    "vibe": "人间真实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 40,
    "text": "没钱，你什么都不是。",
    "category": "扎心现实",
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 41,
    "text": "西装革履下的皮囊到了暗室之中，有太多你想象不到的操作。",
    "category": "扎心现实",
    "vibe": "扎心现实",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 42,
    "text": "信手拈来的从容，都是厚积薄发的沉淀。",
    "category": "扎心现实",
    "vibe": "清醒独立",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 43,
    "text": "任何苦难，都能把我打倒。",
    "category": "扎心现实",
    "vibe": "黑色幽默",
    "author": "弗兰兹·卡夫卡",
    "source": "《卡夫卡日记》",
    "attribution_status": "confirmed"
  },
  {
    "id": 44,
    "text": "慢慢来，好戏都在烟火里。",
    "category": "治愈温柔",
    "vibe": "治愈清醒",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 45,
    "text": "在心里种花，人生才不会荒芜。",
    "category": "治愈温柔",
    "vibe": "治愈温柔",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 46,
    "text": "万物皆有裂痕，那是光照进来的地方。",
    "category": "治愈温柔",
    "vibe": "治愈温柔",
    "author": "莱昂纳德·科恩",
    "source": "《Anthem》歌词",
    "attribution_status": "confirmed"
  },
  {
    "id": 47,
    "text": "睡前原谅一切，醒来不问过往。",
    "category": "治愈温柔",
    "vibe": "治愈清醒",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 48,
    "text": "好好生活，慢慢相遇。",
    "category": "治愈温柔",
    "vibe": "治愈温柔",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 49,
    "text": "星光不问赶路人，时光不负有心人。",
    "category": "治愈温柔",
    "vibe": "治愈清醒",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  },
  {
    "id": 50,
    "text": "山高水长，怕什么来不及，慌什么到不了。",
    "category": "治愈温柔",
    "vibe": "治愈清醒",
    "author": "佚名",
    "source": "网络流传",
    "attribution_status": "anonymous"
  }
]